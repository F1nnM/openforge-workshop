{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openforge-workshop",
  "compatibility_date": "2026-08-01",

  // No Worker script. Cloudflare confirms `main` is optional for
  // assets-only Workers — the previous config's `run_worker_first` and
  // `limits` existed only to scope and budget the iOS/multi-GB zip
  // Worker at `workers/zip/index.ts`, which is deleted (see this plan's
  // Task 3-4: the browsers that Worker existed for now split the
  // archive client-side instead). Without a Worker script both fields
  // are meaningless — Cloudflare's own docs: `run_worker_first`
  // "controls whether static assets are fetched directly, or a Worker
  // script is invoked," and `limits` bounds Worker CPU, neither of
  // which applies when there is nothing to invoke.
  "assets": {
    "directory": "./dist",
    // Client-side routing: unknown paths serve index.html rather than 404ing.
    "not_found_handling": "single-page-application"
  },

  "env": {
    "staging": { "name": "openforge-workshop-staging" },
    "production": {
      "name": "openforge-workshop",
      // The Worker is the origin for this hostname: Cloudflare creates the DNS
      // record and manages the certificate, no separate zone config needed
      // beyond `openforge.tools` already being an active zone (it is —
      // `objects.openforge.tools` already lives there). Scoped to production
      // only: `routes` is per-environment, and staging has no domain of its
      // own, so it stays on its `*.workers.dev` URL.
      "routes": [{ "pattern": "workshop.openforge.tools", "custom_domain": true }]
    }
  }
}
