{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openforge-workshop",
  "compatibility_date": "2026-08-01",

  // No Worker script. Cloudflare confirms `main` is optional for
  // assets-only Workers — the previous config's `run_worker_first` and
  // `limits` existed only to scope and budget the iOS/multi-GB zip
  // Worker at `workers/zip/index.ts`, which is deleted (see this plan's
  // Task 3-4: the browsers that Worker existed for now split the
  // archive client-side instead). Without a Worker script both fields
  // are meaningless — Cloudflare's own docs: `run_worker_first`
  // "controls whether static assets are fetched directly, or a Worker
  // script is invoked," and `limits` bounds Worker CPU, neither of
  // which applies when there is nothing to invoke.
  "assets": {
    "directory": "./dist",
    // Client-side routing: unknown paths serve index.html rather than 404ing.
    "not_found_handling": "single-page-application"
  },

  "env": {
    "staging": {
      "name": "openforge-workshop-staging",
      // A dash, not a dot: `staging-openforge-workshop` is a **first-level**
      // subdomain of `mfinn.de`, which is what free Universal SSL covers
      // (apex plus `*.mfinn.de`, one level only).
      // `staging.openforge-workshop.mfinn.de` would read better and is not
      // otherwise a problem — Cloudflare imposes no subdomain-depth limit, and
      // attaching a Custom Domain issues an Advanced Certificate for the exact
      // hostname — but a second-level name falls outside Universal SSL, and
      // Advanced Certificate Manager is a paid add-on. The failure mode if that
      // subscription is absent is a TLS handshake error *after* a green deploy,
      // so the dash buys certainty rather than saving a subscription we know we
      // need.
      "routes": [{ "pattern": "staging-openforge-workshop.mfinn.de", "custom_domain": true }]
    },
    "production": {
      "name": "openforge-workshop",
      // The Worker is the origin for this hostname: Cloudflare creates the DNS
      // record and manages the certificate, no separate zone config needed
      // beyond `mfinn.de` already being an active Cloudflare zone (it is — its
      // nameservers are rajeev/melany.ns.cloudflare.com). `routes` is
      // per-environment, so this one and staging's above are independent.
      //
      // Note that this hostname is not vacant: it answers 200 today with an
      // unrelated page, from the zone's apex addresses. Attaching the custom
      // domain takes the name over, which is the intent — it is recorded here
      // because the takeover is invisible in this diff otherwise.
      "routes": [{ "pattern": "openforge-workshop.mfinn.de", "custom_domain": true }]
    }
  }
}
