# dependencies
# Trailing slash matters: a worktree provisioned by scratchpad/wt-add.sh gets a
# node_modules *symlink*, which `node_modules/` does not match, so `git add -A`
# in that worktree would stage the link. See wt-node_modules note below.
node_modules
node_modules/
.pnpm-store/

# build output
dist/
.output/
.vite/
*.tsbuildinfo

# environment
.env
.env.*
!.env.example
.dev.vars

# cloudflare
.wrangler/

# editors
.vscode/
.idea/
.*.sw?
.DS_Store

# test / coverage
coverage/
.nyc_output/

# generated catalog artefacts — reproducible from the fixtures, never committed
docs/index-sample-*.json
public/catalog/*.json
public/catalog/*.br

# python bytecode — docs/verify-catalog-facts.py is imported by the pipeline tests
__pycache__/

# scratch
tmp/
scratch/

# npm
package-lock.json.bak
