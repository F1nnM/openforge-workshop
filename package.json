{
  "name": "openforge-workshop",
  "version": "0.1.0",
  "description": "Catalog and room builder for the OpenForge library of 3D-printable modular dungeon terrain",
  "license": "MIT",
  "homepage": "https://openforge-workshop.mfinn.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F1nnM/openforge-workshop.git"
  },
  "bugs": {
    "url": "https://github.com/F1nnM/openforge-workshop/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "stamp": "tsx tools/stamp/cli.ts",
    "thumbs": "tsx tools/thumbnails/cli.ts",
    "measure": "tsx tools/measure/cli.ts",
    "lod": "tsx tools/lod/cli.ts",
    "scad-bench": "tsx tools/scad-bench/cli.ts",
    "refresh:scad": "tsx scripts/refresh-scad.ts",
    "verify:facts": "python3 docs/verify-catalog-facts.py",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-router": "1.170.32",
    "meshoptimizer": "1.2.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-virtuoso": "4.18.12",
    "three": "0.185.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "globals": "^17.11.0",
    "jsdom": "30.0.1",
    "sharp": "0.35.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
